# Backend-only secret. Never use a VITE_ prefix for this key.
GEMINI_API_KEY=replace_with_your_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.8-flash
PORT=5000
# Set to 1 only when your host is behind one trusted reverse proxy.
TRUST_PROXY=0
# In production, include the exact frontend origin(s), comma-separated.
# Example: CLIENT_ORIGIN=http://localhost:5173,https://your-app.vercel.app
CLIENT_ORIGIN=http://localhost:5173
